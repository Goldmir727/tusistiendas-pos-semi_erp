{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi"
    },
    "pwa": {
      "root": "pwa",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/healthz",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/redoc",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "pwa"
      }
    }
  ]
}